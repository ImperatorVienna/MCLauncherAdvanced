{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MC Launcher Advanced",
  "version": "1.0.4",
  "identifier": "dev.personal.javalauncher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MC Launcher Advanced",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://launchercontent.mojang.com; connect-src ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true,
    "enableGTKAppId": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "packaging/mclauncher-advanced.desktop.hbs"
      }
    },
    "resources": {
      "../src/assets/fonts/OFL.txt": "licenses/NotoSans-OFL.txt",
      "licenses/SDL-GameControllerDB.txt": "licenses/SDL-GameControllerDB.txt",
      "licenses/skinview3d.txt": "licenses/skinview3d.txt",
      "licenses/skinview-utils.txt": "licenses/skinview-utils.txt",
      "licenses/three.txt": "licenses/three.txt"
    },
    "shortDescription": "A third-party powered launcher for Minecraft Java Edition with an interface similar to the official.",
    "longDescription": "A third-party powered launcher for Minecraft Java Edition with an interface similar to the official."
  }
}
